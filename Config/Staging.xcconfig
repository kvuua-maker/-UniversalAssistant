PRODUCT_BUNDLE_IDENTIFIER = com.universalassistant.app.staging
CODE_SIGN_ENTITLEMENTS = UniversalAssistant/UniversalAssistant.entitlements
SWIFT_ACTIVE_COMPILATION_CONDITIONS = STAGING
SWIFT_ACTIVE_COMPILATION_CONDITIONS[sdk=iphoneos27.*] = STAGING IOS27_SPEECH_PROBE
SWIFT_ACTIVE_COMPILATION_CONDITIONS[sdk=iphonesimulator27.*] = STAGING IOS27_SPEECH_PROBE
CODE_SIGN_STYLE = Automatic
CODE_SIGNING_ALLOWED = YES
DEVELOPMENT_TEAM = 9V5XXDXF3N
APS_ENVIRONMENT = development
APP_ATTEST_ENVIRONMENT = development
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
INFOPLIST_KEY_NSMicrophoneUsageDescription = UniversalAssistant uses the microphone only when you start a voice command.
INFOPLIST_KEY_NSSpeechRecognitionUsageDescription = UniversalAssistant converts your spoken command into text so it can perform the requested action.
INFOPLIST_KEY_NSContactsUsageDescription = UniversalAssistant accesses contacts only when you ask it to find or contact a person.
INFOPLIST_KEY_NSCalendarsFullAccessUsageDescription = UniversalAssistant accesses Calendar only to find and manage events you request.
INFOPLIST_KEY_NSRemindersFullAccessUsageDescription = UniversalAssistant accesses Reminders only to find and manage reminders you request.
INFOPLIST_KEY_NSLocationWhenInUseUsageDescription = UniversalAssistant uses your location only for nearby, route, navigation, weather, or emergency requests.
INFOPLIST_KEY_NSAppleMusicUsageDescription = UniversalAssistant uses Apple Music access only when you ask to search or play music.
INFOPLIST_KEY_NSPhotoLibraryUsageDescription = UniversalAssistant searches only photos you permit to find requested local results.
INFOPLIST_KEY_NSCameraUsageDescription = UniversalAssistant uses the camera only when you ask to capture an image.
OTHER_LDFLAGS = $(inherited) -ObjC
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
