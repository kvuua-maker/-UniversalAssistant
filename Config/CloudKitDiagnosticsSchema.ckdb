DEFINE SCHEMA

    CREATE ROLE UADiagnosticsReader;

    RECORD TYPE UADiagnosticAudio (
        "___createTime"       TIMESTAMP QUERYABLE SORTABLE,
        "___createdBy"        REFERENCE QUERYABLE,
        "___etag"             STRING,
        "___modTime"          TIMESTAMP,
        "___modifiedBy"       REFERENCE,
        "___recordID"         REFERENCE QUERYABLE,
        appVersion             STRING,
        audio                  ASSET,
        audioByteCount         INT64,
        audioSHA256            STRING QUERYABLE,
        audioTruncated         INT64,
        capturedAt             TIMESTAMP QUERYABLE SORTABLE,
        deviceModel            STRING,
        diagnosticSessionID    STRING QUERYABLE,
        durationMilliseconds   INT64,
        physicalBuild          INT64 QUERYABLE SORTABLE,
        pinned                 INT64 QUERYABLE,
        requestID              STRING QUERYABLE,
        schemaVersion          INT64,
        requestTrace           BYTES,
        requestTraceByteCount  INT64,
        requestTraceSHA256     STRING,
        systemVersion          STRING,
        GRANT READ, WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ, WRITE TO UADiagnosticsReader
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
